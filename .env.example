# Copy to .env.local and fill in. Never commit real keys.

# ── Vapi (voice agent provider) — dashboard.vapi.ai → Organization → API Keys ──
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=

# Optional: real outbound phone calls. Import a Twilio/Vonage/Telnyx number into Vapi
# (Phone Numbers → Import) and paste its Phone Number ID. Free Vapi numbers can't dial out.
VAPI_PHONE_NUMBER_ID=

# The ONLY number the app will ever dial — a phone YOU own (E.164 format).
DEMO_DESTINATION_NUMBER=+91XXXXXXXXXX

# Protects "Call my phone" and "Reset demo" on a public deployment.
ADMIN_PASSCODE=choose-a-passcode

# ── Razorpay (optional) — Test Mode keys from dashboard.razorpay.com (rzp_test_...) ──
# Without them, a built-in mock checkout is used so the demo still works end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only if you register the payment_link.paid webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── Storage — required on Vercel (serverless instances don't share memory) ──
# Added automatically when you connect Upstash Redis from the Vercel Storage tab.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Local development only ──
# Vapi must reach your webhooks; expose localhost with a tunnel and put the URL here.
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ── Optional tuning ──
# VAPI_MODEL_PROVIDER=openai          # or anthropic
# VAPI_MODEL=gpt-4.1                  # e.g. gpt-4o, gpt-4.1-mini, claude-haiku-4-5-20251001
# VAPI_VOICE_PROVIDER=vapi
# VAPI_VOICE_ID=Elliot                # Indian-accent options: Rohan, or Naina / Sagar with VAPI_VOICE_VERSION=2
# VAPI_VOICE_VERSION=
# IGNORE_CALLING_HOURS=false          # true lets you demo outside 8 AM–7 PM IST
# WEB_CALL_DAILY_LIMIT=40             # caps browser calls per day on a public link
# VAPI_WEBHOOK_SECRET=                # defaults to a value derived from VAPI_PRIVATE_KEY
